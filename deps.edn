{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Like the fuel-wholesale (`cloud-itonami-isic-4671`), general-trading
 ;; (`cloud-itonami-isic-4690`), commission-brokerage
 ;; (`cloud-itonami-isic-4610`), agri-wholesale (`cloud-itonami-isic-4620`)
 ;; and provision-trading (`cloud-itonami-isic-4630`) siblings, this
 ;; metal-wholesale vertical is SELF-CONTAINED: there is no
 ;; `kotoba-lang/metaltrade` to delegate metal-trading / conflict-minerals
 ;; provenance validation to, so the credit-clearance / contract-on-file /
 ;; conflict-minerals-provenance / sanctions-screening checks live as
 ;; direct entity boolean reads in `metaltrade.governor` rather than
 ;; wrapping an external lib. This repo is standalone (forkable outside
 ;; the workspace); the :local/root paths only resolve inside the
 ;; monorepo checkout -- a standalone fork should override them with git
 ;; coordinates.
 ;;
 ;; jp-go-digital-design-system (DADS, デジタル庁デザインシステム) is the
 ;; workspace-wide BASE design system. It is a git coordinate rather than a
 ;; :local/root because the operator console is a build artifact that a
 ;; standalone fork must still be able to regenerate. `render_html.clj`
 ;; consumes `jp-go-dds.skin/dds+skin` -- vendored dds.css (tokens) plus the
 ;; compat skin -- and layers only this repo's console layout on top; the
 ;; console's palette is read from DADS tokens, not from raw hex.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "metaltrade.sim"]}
  ;; clojure -M:dev:render-html  -> RUN the actor and render
  ;; docs/samples/operator-console.html from the real run output.
  ;; Throws (and writes nothing) if the run yields no hard governor hold.
  ;; Optional arg: output path (used by the determinism check).
  :render-html {:main-opts ["-m" "metaltrade.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
